# Copiar este archivo a .env.local y completar con los datos
# de tu proyecto de Supabase (Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# Solo para gestión de usuarios (invitar, cambiar roles). Se usa SOLO en
# el servidor (Server Actions) — nunca se expone al navegador.
# Se consigue en Supabase → Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta

# URL pública real de tu app (la de Vercel). Se usa para armar el link
# de activación que reciben los usuarios invitados.
NEXT_PUBLIC_SITE_URL=https://tu-app.vercel.app
